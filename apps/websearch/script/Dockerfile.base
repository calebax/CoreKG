FROM debian:bookworm-slim

ARG DEBIAN_MIRROR=http://deb.debian.org/debian
ARG DEBIAN_SECURITY_MIRROR=http://deb.debian.org/debian-security
ARG UBUNTU_MIRROR=http://archive.ubuntu.com/ubuntu
ARG UBUNTU_PORTS_MIRROR=http://ports.ubuntu.com/ubuntu-ports

RUN set -eux; \
    for source_file in \
        /etc/apt/sources.list \
        /etc/apt/sources.list.d/*.list \
        /etc/apt/sources.list.d/*.sources; do \
        [ -f "${source_file}" ] || continue; \
        sed -i \
            -e "s|http://mirrors.aliyun.com/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
            -e "s|http://mirrors.aliyun.com/debian|${DEBIAN_MIRROR}|g" \
            -e "s|http://mirrors.aliyun.com/ubuntu-ports|${UBUNTU_PORTS_MIRROR}|g" \
            -e "s|http://mirrors.aliyun.com/ubuntu|${UBUNTU_MIRROR}|g" \
            -e "s|https\?://deb.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
            -e "s|https\?://security.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
            -e "s|https\?://deb.debian.org/debian|${DEBIAN_MIRROR}|g" \
            -e "s|https\?://archive.ubuntu.com/ubuntu|${UBUNTU_MIRROR}|g" \
            -e "s|https\?://security.ubuntu.com/ubuntu|${UBUNTU_MIRROR}|g" \
            -e "s|https\?://ports.ubuntu.com/ubuntu-ports|${UBUNTU_PORTS_MIRROR}|g" \
            "${source_file}"; \
    done; \
    apt-get update; \
    apt-get install -y --no-install-recommends chromium chromium-sandbox fonts-noto-cjk; \
    apt-get clean
