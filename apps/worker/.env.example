# NATS
NATS_URL=nats://localhost:4222

# Elasticsearch
ES_HOST=http://localhost:9200
ES_USERNAME=elastic
ES_PASSWORD=change-me
ES_POOL_SIZE=10
ES_TIMEOUT_MS=30000

# S3 / MinIO
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=change-me
S3_REGION=us-east-1
S3_DEFAULT_BUCKET=corekg-bucket
S3_PUBLIC_ENDPOINT_URL=

# Text LLM
LLM_API_KEY=change-me
LLM_BASE_URL=http://localhost:8080/v1/chat/completions
LLM_MODEL=deepseek-v3

# Vision LLM
VLLM_API_KEY=change-me
VLLM_BASE_URL=http://localhost:8080/v1/chat/completions
VLLM_MODEL=qwen3-vl-plus

# Embedding
EMBEDDING_API_KEY=change-me
EMBEDDING_BASE_URL=http://localhost:8000/v1
EMBEDDING_MODEL=Qwen3-Embedding-0.6B

# Concurrency
EB_WORKERS=30
LLM_WORKERS=30

# Worker
WORKER_ID=

# Agent (LLM agent + split/merge)
AGENT_API_URL=http://localhost:8080/v1/chat/completions
AGENT_API_KEY=change-me
AGENT_CHUNK_SIZE=60000
AGENT_MAX_TOKEN_SIZE=120000
AGENT_MAX_WORKERS=50

# Daemon (pdf/video extraction)
DAEMON_URL=http://localhost:5000/local.Run

# Algo Service (split/index)
ALGO_URL=http://localhost:5000/local.Run

# RPC (NATS Request/Reply)
RPC_QUEUE_GROUP=core-task-workers
RPC_TIMEOUT_MS=300000
