# =====================================================================
# Chunk（知识切块 + 向量化 + ES 入库）Worker 配置示例（入库模板）。
# 用法：cp chunk_config.yaml.example chunk_config.yaml，填入你的真实值。
# 键名必须与 corekg_chunk 代码实际读取一致，否则运行时报 KeyError：
#   Work.API_URl / Work.TASK_TYPE / ES.PASS / ES.POOL_SIZE / General.VERSION
# 注意：不是 .example 里的 PASSWORD / api_url / task_type。
# 本模板面向本仓库本地环境（端口统一 +2）；生产按实际地址替换。
# =====================================================================

# ---- 表格摘要 LLM（表增强）。STATUS=false 时跳过 ----
LLM:
  STATUS: false                # 有真实 LLM 且要做表摘要时改 true
  MODEL: deepseek-v3           # TODO 填你的 LLM 模型名
  API_KEY: change-me           # TODO 填你的 LLM api_key
  BASE_URL: http://localhost:8031/v1/chat/completions   # TODO 填你的 LLM /v1/chat/completions

# ---- 视觉大模型 VLLM（图片描述增强）。STATUS=false 时跳过 ----
VLLM:
  STATUS: false                # 有真实视觉模型且要做图片增强时改 true
  MODEL: qwen3-vl-plus         # TODO 填你的视觉模型名
  API_KEY: change-me           # TODO 填你的 VLLM api_key
  BASE_URL: http://localhost:8031/v1/chat/completions   # TODO 填你的视觉 /v1/chat/completions

# ---- Embedding 向量化模型（必需）----
Embedding:
  MODEL: Qwen3-Embedding-0.6B  # TODO 填你的 embedding 模型名
  API_KEY: change-me           # TODO 填你的 embedding api_key
  BASE_URL: http://localhost:8031/v1           # TODO 填你的 embedding /v1（本地 mock 端口 8031）
  # 说明：chunker 向量化走本配置（tools/llm_chat.py 的 chat_with_embedding），**不读 DB 的
  # knowledge/embedding**。无真实模型时可把 BASE_URL 指向 scripts/mock_embedding.py：
  #     python3 scripts/mock_embedding.py --port 8031
  # 有真实模型时填真实端点，如 http://embed-qwen3.003.yygu.cn:58080/v1。

# ---- Elasticsearch ----
ES:
  HOST: http://localhost:9202
  ACCOUNT: elastic
  PASS: "123456"               # 注意键名 PASS（不是 PASSWORD）
  POOL_SIZE: 10
  # 说明：实际索引名来自任务 payload 的 es_index（corekg 生成任务时带入，如 ke_0）；
  # 此处 INDEX 仅供参考。
  INDEX: ke_0

# ---- 并发 ----
Concurrency:
  EB_WORKS: 10
  LLM_WORKS: 10
  LLM_TIMEOUT: 300

# ---- 版本号（写入 ES 文档 version 字段）----
General:
  VERSION: "1.0.0"

# ---- 任务接入（corekg 聚合 HTTP 端点）----
Work:
  API_URl: http://localhost:8080/v3    # 注意键名 API_URl；指 corekg 聚合 /v3
  TASK_TYPE: ke.knowledge_task
  # API_URl 主机名取决于 corekg 如何暴露：
  #   - 本地宿主模式：corekg 二进制跑 :8080 → http://localhost:8080/v3
  #   - docker-compose 拉起：corekg 服务名 = corekg → http://corekg:8080/v3
  #   - corekg 是手动 docker run 的容器（无 `corekg` 别名，容器名 corekg-app）→ http://corekg-app:8080/v3
