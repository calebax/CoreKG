# Chunk 服务配置示例。
# 用法：cp chunk_config.yaml.example chunk_config.yaml，填入本地/真实值。

LLM:
  STATUS: true
  MODEL: deepseek-v3
  API_KEY: change-me
  BASE_URL: http://localhost:8080/v1/chat/completions

VLLM:
  STATUS: true
  MODEL: qwen3-vl-plus
  API_KEY: change-me
  BASE_URL: http://localhost:8080/v1/chat/completions

Embedding:
  MODEL: Qwen3-Embedding-0.6B
  API_KEY: change-me
  BASE_URL: http://localhost:8000/v1

ES:
  HOST: http://localhost:9200
  ACCOUNT: elastic
  PASSWORD: change-me
  INDEX: ke_0

Concurrency:
  EB_WORKS: 30
  LLM_WORKS: 30
  LLM_TIMEOUT: 300

General:
  VERSION: "1.0.0"

Work:
  api_url: http://localhost:8080
  task_type: chunk
