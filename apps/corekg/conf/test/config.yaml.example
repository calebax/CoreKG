# CoreKG 聚合服务本地开发配置示例。
# 使用方式：
#   1. cp config.yaml.example config.yaml
#   2. 启动本地依赖（见仓库根 docker-compose.yml）：docker compose up -d
#   3. 按需修改 config.yaml 中标记为 change-me 的密钥
#
# 所有真实密钥一律不要提交；config.yaml 已被 .gitignore 忽略。

main:
  app: corekg
  http_addr: :8080
  open_docs_api: true
  base_url: http://localhost:8080
  env: test
  web_dir: ./web/dist/
  database_conns:
    core: mysql://corekg:123456@localhost:3308/corekg?charset=utf8mb4&parseTime=true&loc=Local
    account: mysql://corekg:123456@localhost:3308/corekg?charset=utf8mb4&parseTime=true&loc=Local
    knownow: mysql://corekg:123456@localhost:3308/corekg?charset=utf8mb4&parseTime=true&loc=Local
    chat: mysql://corekg:123456@localhost:3308/corekg?charset=utf8mb4&parseTime=true&loc=Local
    llm: mysql://corekg:123456@localhost:3308/corekg?charset=utf8mb4&parseTime=true&loc=Local

redis:
  addr: localhost:6381
  password: ""
  db: 1

# workflow 聚合开关：默认 disabled，不启动。开启后 corekg 进程内额外在独立
# 端口拉起 workflow（Hertz）server，经网关转发对外。
workflow:
  enabled: false            # 是否在 corekg 进程内拉启 workflow
  required: false           # true=启动失败则 corekg 整体退出；false=仅告警继续
  http_addr: ":8899"        # workflow Hertz server 独立监听地址
  max_request_body_size: 1073741824
  log_level: info
  server_host: "http://localhost:8899"
  admin_uins: ""
  ssl:
    enabled: false
    cert_file: ""
    key_file: ""
  redis:
    addr: "${REDIS_ADDR}"
    password: "${REDIS_PASSWORD}"
    db: 0
  elasticsearch:
    addr: "${ES_ADDR}"
    username: "${ES_USERNAME}"
    password: "${ES_PASSWORD}"
    version: v8
    number_of_shards: "1"
    number_of_replicas: "1"
  storage:
    type: minio
    upload_http_scheme: http
    bucket: opencoze-test
    minio:
      ak: "${MINIO_AK}"
      sk: "${MINIO_SK}"
      endpoint: "${MINIO_ENDPOINT}"
      region: "${MINIO_REGION}"
      api_host: "${MINIO_API_HOST}"
    tos:
      access_key: ""
      secret_key: ""
      endpoint: ""
      region: ""
    s3:
      access_key: ""
      secret_key: ""
      endpoint: ""
      region: ""
      bucket_endpoint: ""
  mq:
    type: nats
    name_server: "${NATS_URL}"
    nats:
      jwt_token: ""
      nkey_seed: ""
      username: ""
      password: ""
      token: ""
      use_jetstream: true
  upload:
    component_type: storage
    imagex:
      ak: ""
      sk: ""
      server_id: ""
      domain: ""
      template: ""
      upload_host: "https://imagex.volcengineapi.com"

account:
  jwt_secret: change-me
  plt_jwt_secret: change-me
  jwt_expire: 8h

zmrobot:
  captcha_image_dir: ./var/captcha/

local_storage:
  dir: ./var/storage/

notify:
  smtp:
    addr: smtp.example.com:465
    username: noreply@example.com
    password: change-me
    nickname: CoreKG

wecom:
  apps:
    - name: roc_message
      company_id: change-me
      agent_id: 1000002 # AgentId
      secret: change-me
      token: change-me
      encoding_aes_key: change-me
    - name: owl_message
      company_id: change-me
      agent_id: 1000006 # AgentId
      secret: change-me
      token: change-me
      encoding_aes_key: change-me
    - name: chatgpt
      company_id: change-me
      agent_id: 1000007 # AgentId
      secret: change-me
      token: ""
      encoding_aes_key: ""

tencent_cloud:
  - AppId: change-me
    SecretId: change-me
    SecretKey: change-me
    Region: ap-beijing

name: roc_message
company_id: change-me
agent_id: 1000002 # AgentId
secret: change-me
token: change-me
encoding_aes_key: change-me

logger:
  default:
    - writer: console
      level: debug
    - writer: file
      level: debug
      filename: ./logs/default.log
      maxsize: 10
      maxage: 15
      maxbackups: 5
      localtime: true
      compress: true
    - writer: workwx
      level: error
      key: change-me
  gorm:
    - writer: console
      level: debug
  access:
    - writer: console
      level: debug
    - writer: file
      level: debug
      filename: ./logs/access.log
      maxsize: 10
      maxage: 15
      maxbackups: 5
      localtime: true
      compress: true
