# keinit 初始化所需环境变量（docker-compose 模式），渲染 scripts/mysql/variable.sqltpl 及各 SQL 模板。
# 密码/地址与 docker-compose.yml 及 apps/keinit/conf/docker/config.yaml 保持一致。

# 服务地址（登录 login_setting.domain_name 由 BASE_HOST 推导）
BASE_URL = http://localhost:30000
BASE_HOST = localhost

# LLM 对话模型（仅写入种子数据，通路验证不依赖其连通）
LLM_MODEL_SHOWNAME = deepseek-v3
LLM_MODEL_APIKEY = yg-xxxxx
LLM_MODEL = deepseek/deepseek-v3
LLM_MODEL_URL = https://yygu.cn/v3/llm.chat/chat/completions

# 视觉模型
LLM_VL_MODEL_URL = https://yygu.cn/v3/llm.chat/chat/completions
LLM_VL_MODEL = qwen2.5-vl-72b-instruct
LLM_VL_MODEL_APIKEY = yg-xxxxx

# Embedding 向量模型
LLM_EMBEDDING_MODEL_URL = https://example.com:53081/v1/embeddings
LLM_EMBEDDING_MODEL_APIKEY = yg-xxxxx
LLM_EMBEDDING_MODEL_NAME = embedding

# 智能体 APIKEY
AGENT_MODEL_APIKEY = yg-xxxxx

# LICENSE（微秒时间戳占位，本地不启用 license 强制校验）
LICENSE = 0

# MinIO 对象存储（compose 服务名 + 容器内端口）
MINIO_ACCESS_KEY_ID = minioadmin
MINIO_SECRET_ACCESS_KEY = minio123456

# Elasticsearch
ES_PASSWORD = 123456
