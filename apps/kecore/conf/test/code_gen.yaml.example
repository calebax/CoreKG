# codegen 配置示例（用于私有工具 yggocli，需 SSH 访问 git.yygu.cn）。
# 用法：cp code_gen.yaml.example code_gen.yaml；将 mysql_dsn 改为本地/可访问的数据库。
mysql_dsn: corekg:corekg_dev@tcp(localhost:3306)/corekg?charset=utf8mb4&parseTime=true&loc=Local
#layer_parent_dir_map:
#  model: model
#  dao: dao
#layer_name_map:
#  model: mysqlmodel
#  dao: mysqldao
module:
  package_name: user
  dao_layer_name: patent
  description: 用户登录记录
  table_name: ke_keywords
model:
  package_name: forest
  dao_layer_name: forest
  model_layer_name: foresttype
  table_prefix: ke_
  description: 文章编辑历史
  table_name: ke_article_history
api:
  package_name: article
  target_filename: article.go
  function_name: ExecuteAIWriteCmd
  http_method: POST
  description: AI写作指令执行接口
  api_doc_tag: 写作空间
# make codegen MODE=model APP=kecore
# make codegen MODE=api APP=kecore
