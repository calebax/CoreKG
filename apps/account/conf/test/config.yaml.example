# account 服务本地开发配置示例。
# 用法：cp config.yaml.example config.yaml；启动本地依赖后按需修改 change-me 处。
main:
  app: account
  http_addr: :8081
  open_docs_api: true
  base_url: http://localhost:8081
  mysql: corekg:123456@tcp(localhost:3308)/corekg?charset=utf8mb4&parseTime=true&loc=Local
  web_dir: ./web/dist/
  env: dev
  database_conns:
    core: mysql://corekg:123456@localhost:3308/corekg?charset=utf8mb4&parseTime=true&loc=Local
    account: mysql://corekg:123456@localhost:3308/corekg?charset=utf8mb4&parseTime=true&loc=Local
    knownow: mysql://corekg:123456@localhost:3308/corekg?charset=utf8mb4&parseTime=true&loc=Local
    chat: mysql://corekg:123456@localhost:3308/corekg?charset=utf8mb4&parseTime=true&loc=Local

logger:
  default:
    - writer: console
      level: debug
    - writer: file
      level: debug
      filename: ./logs/default.log
      maxsize: 10
      maxage: 15
      maxbackups: 5
      localtime: true
      compress: true
    - writer: workwx
      level: error
      key: change-me
  gorm:
    - writer: console
      level: debug
  access:
    - writer: console
      level: debug
    - writer: file
      level: debug
      filename: ./logs/access.log
      maxsize: 10
      maxage: 15
      maxbackups: 5
      localtime: true
      compress: true

account:
  jwt_secret: change-me
  plt_jwt_secret: change-me
  jwt_expire: 8h

zmrobot:
  captcha_image_dir: ./var/captcha/

local_storage:
  dir: ./var/storage/

notify:
  smtp:
    addr: smtp.example.com:465
    username: noreply@example.com
    password: change-me
    nickname: CoreKG

wecom:
  apps:
  - name: roc_message
    company_id: change-me
    agent_id: 1000002 # AgentId
    secret: change-me
    token: change-me
    encoding_aes_key: change-me
  - name: owl_message
    company_id: change-me
    agent_id: 1000006 # AgentId
    secret: change-me
    token: change-me
    encoding_aes_key: change-me
  - name: chatgpt
    company_id: change-me
    agent_id: 1000007 # AgentId
    secret: change-me
    token: ''
    encoding_aes_key: ''

tencent_cloud:
  - AppId: change-me
    SecretId: change-me
    SecretKey: change-me
    Region: ap-beijing

name: roc_message
company_id: change-me
agent_id: 1000002 # AgentId
secret: change-me
token: change-me
encoding_aes_key: change-me
