# .env.development.example
# 用法：cp .env.development.example .env.development，将 API 地址改为本地后端地址。
VITE_API_URL=http://localhost:8080
VITE_MINIO_URL=http://localhost:9002
VITE_WORKFLOW_URL=http://localhost:8088
VITE_LOGIN_URL=http://localhost:8081
# 空字符串
VITE_META_DESCRIPTION=
# 部署模式配置 (h3c 或 jiefang)
# 默认使用h3c模式，需要测试jiefang时改为jiefang
VITE_DEPLOY_MODE=jiefang
