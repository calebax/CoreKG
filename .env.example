# CoreKG 本地开发环境变量示例（对应 apps/workflow/conf/test/config.yaml 中的 ${VAR}）。
# 用法：
#   cp .env.example .env
#   docker compose up -d
#   set -a; . .env; set +a
#   make run APP=workflow ENV=test
#
# 默认值与本仓库 docker-compose.yml.example 及各 apps/*/conf/*/config.yaml.example 保持一致，
# 仅用于本地开发，生产环境请替换为真实凭据。

# --- MySQL（主存储）---
# workflow 的 core 库连接
COREKG_CORE_USER=corekg
COREKG_CORE_PASS=corekg_dev
COREKG_CORE_HOST=localhost
COREKG_CORE_PORT=3306
COREKG_CORE_DB=corekg
# workflow 的 opencoze 库连接
MYSQL_USER=corekg
MYSQL_PASS=corekg_dev
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=opencoze

# --- Elasticsearch（RAG 检索）---
ES_ADDR=http://localhost:9200
ES_USERNAME=elastic
ES_PASSWORD=change-me

# --- Redis（缓存/锁/队列）---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# --- MinIO / S3（对象存储）---
MINIO_ENDPOINT=http://localhost:9000
MINIO_AK=minioadmin
MINIO_SK=change-me
MINIO_REGION=us-east-1
MINIO_API_HOST=http://localhost:9000

# --- NATS（任务系统 + workflow 事件总线，统一使用）---
NATS_URL=nats://localhost:4222
