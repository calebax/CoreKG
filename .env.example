# CoreKG 本地开发环境变量示例（对应 apps/workflow/conf/test/config.yaml 中的 ${VAR}）。
# 用法：
#   cp .env.example .env
#   docker compose up -d
#   set -a; . .env; set +a
#   make run APP=workflow ENV=test
#
# 默认值与本仓库 docker-compose.yml 及各 apps/*/conf/*/config.yaml.example 保持一致。
# 连接说明：宿主机端口在容器默认端口基础上统一 +2（见 docs/local-development.md）；
#           所有中间件明文密码统一为 123456（本地开发默认值，生产请替换为真实凭据）。

# --- MySQL（主存储，宿主机映射端口 3308）---
# workflow 的 core 库连接
COREKG_CORE_USER=corekg
COREKG_CORE_PASS=123456
COREKG_CORE_HOST=localhost
COREKG_CORE_PORT=3308
COREKG_CORE_DB=corekg
# workflow 的 opencoze 库连接
MYSQL_USER=corekg
MYSQL_PASS=123456
MYSQL_HOST=localhost
MYSQL_PORT=3308
MYSQL_DB=opencoze

# --- Elasticsearch（RAG 检索，宿主机映射端口 9202）---
ES_ADDR=http://localhost:9202
ES_USERNAME=elastic
ES_PASSWORD=123456

# --- Redis（缓存/锁/队列，宿主机映射端口 6381，无密码）---
REDIS_ADDR=localhost:6381
REDIS_PASSWORD=

# --- MinIO / S3（对象存储，宿主机映射端口 9002）---
# 注意：workflow 的 minio-go 客户端会自行拼接 scheme（取自 config 的 upload_http_scheme），
#       因此 MINIO_ENDPOINT / MINIO_API_HOST 必须是「裸 host:port」，不能带 http(s):// 前缀，
#       否则报 "Endpoint url cannot have fully qualified paths."。
# MINIO_SK 需与本仓库 docker-compose.yml 的 MINIO_ROOT_PASSWORD（minio123456）一致；裸机请改自己的密钥。
MINIO_ENDPOINT=localhost:9002
MINIO_AK=minioadmin
MINIO_SK=minio123456
MINIO_REGION=us-east-1
MINIO_API_HOST=localhost:9002

# --- NATS（任务系统 + workflow 事件总线，宿主机映射端口 4225，无认证）---
# 注：原默认 4224 可能与 OrbStack 的 dbx 辅助进程端口冲突，改用 4225。
NATS_URL=nats://localhost:4225
