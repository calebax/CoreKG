SET NAMES utf8mb4;

-- 服务地址 CHANGE_ME_HOST
SET @yg_BASE_URL = '{{ .BASE_URL }}';

-- 服务地址 CHANGE_ME_HOST
SET @yg_BASE_HOST = '{{ .BASE_HOST }}';

-- 模型展示名称 deepseek-v3(官方)
SET @yg_LLM_MODEL_SHOWNAME = '{{ .LLM_MODEL_SHOWNAME }}';

-- 模型apikey yg-xxxxx
SET @yg_LLM_MODEL_APIKEY = '{{ .LLM_MODEL_APIKEY }}';

-- 模型 deepseek/deepseek-v3
SET @yg_LLM_MODEL = '{{ .LLM_MODEL }}';

-- 模型 https://yygu.cn/v3/llm.chat/chat/completions
SET @yg_LLM_MODEL_URL = '{{ .LLM_MODEL_URL }}';

-- 视觉模型url https://yygu.cn/v3/llm.chat/chat/completions
SET @yg_LLM_VL_MODEL_URL = '{{ .LLM_VL_MODEL_URL }}';

-- 模型 qwen2.5-vl-72b-instruct
SET @yg_LLM_VL_MODEL = '{{ .LLM_VL_MODEL }}';

-- 模型apikey yg-xxxxx
SET @yg_LLM_VL_MODEL_APIKEY = '{{ .LLM_VL_MODEL_APIKEY }}';

-- 向量 https://example.com:53081/v1/embeddings
SET @yg_LLM_EMBEDDING_MODEL_URL = '{{ .LLM_EMBEDDING_MODEL_URL }}';

-- 模型apikey 123
SET @yg_LLM_EMBEDDING_MODEL_APIKEY = '{{ .LLM_EMBEDDING_MODEL_APIKEY }}';

--智能体APIKEY
SET @yg_AGENT_MODEL_APIKEY = '{{ .AGENT_MODEL_APIKEY }}';

-- 模型名称
SET @yg_LLM_EMBEDDING_MODEL_NAME = '{{ .LLM_EMBEDDING_MODEL_NAME }}';

-- LICENSE 时间戳微秒
SET @yg_LICENSE = '{{ .LICENSE }}';

-- MINIO_ACCESS_KEY_ID minio 的 access_key_id
SET @yg_MINIO_ACCESS_KEY_ID = '{{ .MINIO_ACCESS_KEY_ID }}';

-- MINIO_ACCESS_KEY_ID minio 的 secret_access_key
SET @yg_MINIO_SECRET_ACCESS_KEY = '{{ .MINIO_SECRET_ACCESS_KEY }}';

-- S_PASSWORD es的密码
SET @yg_ES_PASSWORD = '{{ .ES_PASSWORD }}';

-- MySQL 主机地址，例如 127.0.0.1
SET @yg_MYSQL_HOST = '{{ .MYSQL_HOST }}';

-- MySQL 端口，例如 3306
SET @yg_MYSQL_PORT = '{{ .MYSQL_PORT }}';

-- MySQL 用户名，例如 root
SET @yg_MYSQL_USER = '{{ .MYSQL_USER }}';

-- MySQL 密码，例如 123456
SET @yg_MYSQL_PASSWORD = '{{ .MYSQL_PASSWORD }}';

-- admin 用户密码 hash（bcrypt），例如 CHANGE_ME
SET @yg_ADMIN_PASSWORD_HASH = '{{ .ADMIN_PASSWORD_HASH }}';


